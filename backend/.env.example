# ---- Database --------------------------------------------------------------
# SQLite for local dev (zero infra). Point at Postgres 17 in prod, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/learnflow
DATABASE_URL=sqlite:///./learnflow.db

# ---- JWT -------------------------------------------------------------------
# REQUIRED in production. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# HS256 today; the token module is structured so RS256 is a config swap (NFR-03).
JWT_SECRET=dev-only-change-me-please-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---- Account lockout (AC-AUTH-06) ------------------------------------------
MAX_FAILED_ATTEMPTS=5
LOCKOUT_WINDOW_MINUTES=10
LOCKOUT_MINUTES=15

# ---- CORS ------------------------------------------------------------------
# Comma-separated origins allowed to call the API (the Vite frontend dev server).
CORS_ORIGINS=http://localhost:5173
