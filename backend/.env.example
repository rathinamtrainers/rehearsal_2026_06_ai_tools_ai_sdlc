# ---------------------------------------------------------------------------
# LearnFlow Auth backend — environment configuration
# Copy to .env and adjust. All values have sane dev defaults in app/config.py.
# ---------------------------------------------------------------------------

# Database — SQLite for dev, Postgres for prod.
# Dev (default):
DATABASE_URL=sqlite:///./learnflow.db
# Prod example:
# DATABASE_URL=postgresql+psycopg://learnflow:secret@localhost:5432/learnflow

# JWT — HS256 in dev; RS256-ready (set JWT_ALGORITHM=RS256 and point at PEM keys).
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=dev-only-change-me-to-a-long-random-string
# For RS256 (leave blank for HS256):
# JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Brute-force lockout (named / per-user).
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_MINUTES=10
LOCKOUT_DURATION_MINUTES=15

# Dev convenience: register users straight to ACTIVE (skip email verification).
# Set to false to use the real PENDING_VERIFICATION flow.
REGISTER_ACTIVE=true

# CORS — origins allowed to call the API with credentials (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
