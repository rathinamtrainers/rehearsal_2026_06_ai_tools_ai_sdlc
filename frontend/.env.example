# Base URL of the LearnFlow FastAPI backend (no trailing slash).
# When set and reachable, the auth UI POSTs to ${VITE_API_BASE}/auth/*.
# When unset OR the backend is unreachable, the UI falls back to an
# in-browser mock so it runs standalone.
#
# Example:
# VITE_API_BASE=http://localhost:8000
VITE_API_BASE=
