# Base URL of the LearnFlow FastAPI backend (the /auth/* endpoints).
# Leave unset to run the UI standalone against the in-browser mock
# (password under 4 chars -> invalid credentials, locked@learnflow.io -> lockout).
# Set this once the FastAPI backend from backend/UC-1-requirements.md is running:
# VITE_API_BASE=http://localhost:8000
VITE_API_BASE=
